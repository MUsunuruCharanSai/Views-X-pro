# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Server Environment (development / production)
APP_ENV=production

# FFmpeg — required for merging video+audio (WinGet installs often need this)
# FFMPEG_PATH=C:\path\to\ffmpeg\bin\ffmpeg.exe

# Railway / low-RAM hosts (also set automatically in Dockerfile)
# FFMPEG_LOW_MEMORY=1
# FFMPEG_THREADS=2

# YouTube cookies — recommended on Railway if downloads hit bot-checks
# Preview works without cookies (oEmbed fallback). Downloads may still need:
#   YTDLP_COOKIES_FILE=cookies.txt
# or Railway Variables:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
#   YTDLP_COOKIES_BASE64=...
# Local only:
#   YTDLP_COOKIES_FROM_BROWSER=firefox
